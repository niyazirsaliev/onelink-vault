# US cloud default. EU: https://vault.bitwarden.eu
# Self-hosted: https://vault.example.com
VW_URL=https://vault.bitwarden.com
PORT=8000
# Generate locally; empty disables all admin endpoints.
ADMIN_KEY=
# Optional: fixed HTTPS origin, no path. Empty disables intake.
INTAKE_PUBLIC_BASE_URL=
# Explicit opt-in, comma-separated caller names; write must be a subset of read.
CROSS_VAULT_READ_CALLERS=
CROSS_VAULT_WRITE_CALLERS=
BW_COMMAND_TIMEOUT_SECONDS=30
BW_REAP_TIMEOUT_SECONDS=5
# Native Python deployments can override these defaults too:
# AUDIT_DB_PATH=/var/lib/vault-gateway/audit.db
# CALLERS_FILE_PATH=/var/lib/vault-gateway/callers.json
# BW_HOME_BASE=/var/lib/vault-gateway/bw-homes
# INTAKE_STATE_DIR=/var/lib/vault-gateway/intake
